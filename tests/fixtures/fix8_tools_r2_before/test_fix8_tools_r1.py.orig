def test_c5_stall_after_r1_is_not_marked(tmp_path):
    """止まりが R1 の起点のあと(最初の周の途中)なら launch_stall は付かない = 直す前とバイト単位で同じ"""
    D, log35 = sday(tmp_path, 'S', stall=(4.5, 5.4))
