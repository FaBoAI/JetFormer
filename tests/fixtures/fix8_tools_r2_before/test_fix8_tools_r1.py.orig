    assert any(x.startswith('  → OFF の発進が全部カメラの止まりで比べから外れた') for x in on.splitlines())


@pytest.mark.parametrize('case', ['N', 'A'])
def test_c5_no_stall_in_launch_is_bit_identical(tmp_path, case):
