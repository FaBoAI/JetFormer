DESK = EXP / 'c3' / 'desk_v3.py'
EVAL = EXP / 'c3' / 'eval_v3.py'
QUEUE_EVAL = EXP / 'desk_v3' / 'eval_v3.py'        # gpu_queue_v3.py・.sh の EVAL_V3(キューが机上の予測で見る場所)
DATA_OUT = EXP / 'data' / 'out'
RUNS = REPO / 'data' / 'runs'
DISK_MIN_GB = 5.0

# 学習の前(build_data.md 10 章・11 章、2026-10-26 13:10)の sha256。違えば止まる
EXPECT_TABLES = {
    'drop_v3n.npz': '3ff5bf9de2710153f11ec5b0c5a8a77fbe49ea1abc939abcd6f8a29b8ed413d1',
    'drop_v3d.npz': '1b78eb8ba27dfe1a32f11b53194a36329319d0ccd68dfba4d622493404e3de5f',
    'override_v3d_tk_thr_B.npz': 'ebc6caa977b4bfa334e73ed261ac8b7bccabe0a7c77813d139845f712e29e43f',
    'drop_v3b.npz': '335e1a3be76847c2b732b4c905a81d71aca7456ac561635c705cfb47bdd7702a',
    'tables_v3.json': '7b3b724e1fe77062ba690d1a5c2f6ca96d305cf3ef06b818e8a63c05eac5a614',
}
EXPECT_CODE = {
    'tools/train.py': 'e04f7be8d9946af4a511b90002a4542e5b42e61c7cfadec2d079eff8450707f8',
    'jetformer/train_data.py': 'b01513bfa0ec9c274c2ce5adc7009ae83d527ec7702dc15cd986ea51b49fd0d0',
    'jetformer/dataset.py': 'e63e9673eaac8d7215924f9ef27c61c432a624a91099976107cdd5efea134306',
}
EXPECT_QUEUE_PREFIX = {'gpu_queue_v3.sh': '9befa63d', 'gpu_queue_v3.py': 'baf9050c', 'gpu_queue_v3.tsv': 'ab25aac3'}
OTHER_CODE = ('tools/build_engine.py', 'jetformer/trt_runtime.py', 'jetformer/policies/jetformer_v0.py')   # gpu_queue_v3.py CODE_FILES の残り
