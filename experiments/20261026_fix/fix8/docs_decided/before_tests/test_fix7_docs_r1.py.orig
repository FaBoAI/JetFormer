def _todo_block(td):
    t4 = chapter(td, '## 4. jetformer-web の再起動の手順と確かめ', '\n- 4 で `launch_boost`')
    return t4[t4.index('```bash'):]


def _cmd_after(block, head):
    """コードの中で、head で始まるコメントのあとの最初のコマンドの行(無ければ '')"""
    lines = block.splitlines()
    for i, x in enumerate(lines):
        if x.startswith(head):
            for y in lines[i + 1:]:
                if y.strip() and not y.startswith('#'):
                    return y
    return ''


def restart_cmd(d):
    return _cmd_after(_todo_block(d[TODO]), '# 3. ')


def boot_cmds(d):
    """11/3 の朝の journal のコマンド: todo 4 章の 3' と手順書 3.1 の頭(どちらも無ければ '')"""
    t31 = chapter(d[RB], '### 3.1', '## 4. ')
    m = re.search(r'`(systemctl is-active jetformer-web;[^`]*)`', t31)
    return _cmd_after(_todo_block(d[TODO]), "# 3'. "), (m.group(1) if m else '')


def f2_problems(d):
    """w1-docs-r71-docs-2: journal は今の起動のあとだけ(古い -n 60 が無い)"""
    p = []
    rc = restart_cmd(d)
    for w in ('systemctl is-active jetformer-web', 'NRestarts', '--since "$(systemctl show -p ActiveEnterTimestamp --value jetformer-web)"',
              'grep -n "Traceback\\|Error"', 'echo "エラーの行なし"'):
        if w not in rc:
            p.append('todo 4 章 3 のコマンドに「%s」が無い' % w)
    for c, where in zip(boot_cmds(d), ("todo 4 章 3'", '手順書 3.1')):
        for w in ('systemctl is-active jetformer-web', 'NRestarts', 'journalctl -u jetformer-web -b', 'echo "エラーの行なし"'):
            if w not in c:
                p.append('%s の 11/3 の朝のコマンドに「%s」が無い' % (where, w))
    for f, t in ((TODO, _todo_block(d[TODO])), (RB, chapter(d[RB], '### 3.1', '## 4. '))):
        for x in t.splitlines():
            if not x.lstrip().startswith('#') and re.search(r'journalctl[^`|]* -n \d', x):
                p.append('%s: journalctl -n の行が残っている: %s' % (f, x[:60]))
    _miss(p, '手順書 3.1 の 17:16 の記録', chapter(d[RB], '### 3.1', '## 4. '), 'journal にエラーなし(17:16:28 の起動から')
    _miss(p, 'todo 4 章の 17:16 の記録', d[TODO], '3 の journal にエラーなし(17:16:28 の起動から')
    _miss(p, 'fix6/README 6 章', d[F6], 'journal にエラーなし(17:16:28 の起動から)')
    return p


