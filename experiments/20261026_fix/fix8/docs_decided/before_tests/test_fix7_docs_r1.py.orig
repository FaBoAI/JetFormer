def pytest_full_numbers():
    t = (REPORTS / 'fix6' / 'pytest_full_20261027.txt').read_text(encoding='utf-8')
    du = re.findall(r'^(\d+(?:\.\d+)?)G\texperiments/20261026_fix/tmp_pytest_full_20261027$', t, re.M)
    df = re.findall(r'^/dev/\S+\s+\S+\s+\S+\s+(\d+(?:\.\d+)?)G\s', t, re.M)
    return du[-1], df[0], df[-1]


def f5_problems(d):
    """w1-docs-r71-docs-5: pytest 一式の作業場所は 10/27 の実測(fix6/pytest_full_20261027.txt と同じ数)"""
    p = []
    du, start, end = pytest_full_numbers()
    r4 = one(chapter(d[RD], '### 3.2', '### 3.3'), '| 4 | pytest 一式 |')
    _miss(p, 'README 3.2 の 4', r4, '約 %s GB' % du, '空き %s GB → 終わり %s GB' % (start, end))
    # disk_check.py の PYTEST_GB(担当の外。直すかは tools の係か main session)が実測と違うあいだは、そのことを README に書く
    dsrc = (JF / 'experiments' / '20261026_fix' / 'fix3' / 'disk' / 'disk_check.py').read_text(encoding='utf-8')
    gb = re.search(r'^PYTEST_GB = (\d+(?:\.\d+)?)', dsrc, re.M).group(1)
    if gb != du and 'tmp_path_retention_policy=failed' in dsrc:
        # 2026-10-28 fix8 tools-decided: PYTEST_GB を 10/28 の実測(-o tmp_path_retention_policy=failed を付けた一式。
        # fix7/pytest_full_20261028.txt)にした。そのときは README に、その値とオプションが要ることを書く(前の「のまま」は消す)
        _miss(p, 'README 3.2 の 4', r4, '`PYTEST_GB` は %s' % gb, 'tmp_path_retention_policy=failed')
        if 'のまま' in r4.split('PYTEST_GB')[-1][:12]:
            p.append('README 3.2 の 4: disk_check.py の PYTEST_GB は %s になったのに「のまま」と書いている' % gb)
    elif gb != du:
        _miss(p, 'README 3.2 の 4', r4, '`PYTEST_GB` は %s のまま' % gb)
    elif 'のまま' in r4.split('PYTEST_GB')[-1][:12]:
        p.append('README 3.2 の 4: disk_check.py の PYTEST_GB は %s になったのに「のまま」と書いている' % gb)
    if '(一式 1 回で約 3.9 GB)' in r4:
        p.append('README 3.2 の 4: 3.9 GB のまま')
    _miss(p, 'approvals 1 なぜ', one(chapter(d[AP], '## 1. ディスクの片付け', '## 2. '), '| なぜ |'),
          '10/27 の一式の実測は約 %s GB' % du, '11 GB → 終わり %s GB' % end)
    _miss(p, 'fix6/README 7 章 1', one(chapter(d[F6], '## 7. 次に', '### 今のファイル'), '| 1 |'), '作業場所に約 %s GB 要る' % du)
    return p


CHECKS = {'f1': f1_problems, 'f2': f2_problems, 'f3': f3_problems, 'f4': f4_problems, 'f5': f5_problems}


# ================================================================== 文書
@pytest.mark.parametrize('name', sorted(CHECKS))
def test_live_documents(live, name):
    assert CHECKS[name](live) == []


@pytest.mark.parametrize('name', sorted(CHECKS))
def test_before_copies_fail(before, name):
    """直す前の写し(10/27 17:4x の fix7 docs のあと)では、5 つの指摘がどれも出る"""
    assert CHECKS[name](before) != []


def test_script_edits_all_done(live, script):
    """直しの台本の直しは、今の文書でどれも「済」(もう一度流しても何もしない)。画面の版 9 の直しも済のまま"""
    _, rep = script.apply_text(live)
    assert len(rep) == 44 and [s for _, _, s in rep] == ['done'] * 44, [(f, o[:30], s) for f, o, s in rep if s != 'done']
    m = script.ban9()
    b9 = {f: (REPORTS / f).read_text(encoding='utf-8') for f in m.FILES}
    _, rep9 = m.apply_text(b9)
    assert all(s == 'done' for _, _, s in rep9) and m.stale(b9, m.versions()[0]) == []


# 直しの台本の (文書, 何番目) → それを元に戻すと落ちる確かめ。書いていない 3 つは頭の記録の行だけ(「済」の試験が見る)
CATCH = {(RB, 1): 'f1', (RB, 2): 'f1', (RB, 3): 'f2', (RB, 4): 'f2', (RB, 5): 'f1', (RB, 6): 'f1', (RB, 7): 'f1', (RB, 8): 'f1',
         (RB, 9): 'f3', (RB, 10): 'f1', (RB, 11): 'f1', (RB, 12): 'f1', (RB, 13): 'f1', (RB, 14): 'f1', (RB, 15): 'f1',
         (RB, 16): 'f1', (RB, 17): 'f3', (RB, 18): 'f4',
         (TODO, 0): 'f4', (TODO, 1): 'f4', (TODO, 2): 'f4', (TODO, 3): 'f4', (TODO, 4): 'f3', (TODO, 5): 'f1', (TODO, 6): 'f1',
         (TODO, 7): 'f1', (TODO, 8): 'f2', (TODO, 9): 'f2',
         (RD, 1): 'f4', (RD, 2): 'f5', (RD, 3): 'f4',
         (AP, 0): 'f4', (AP, 1): 'f4', (AP, 2): 'f5', (AP, 3): 'f1', (AP, 4): 'f3', (AP, 5): 'f1', (AP, 6): 'f4',
         (F6, 1): 'f2', (F6, 2): 'f5', (F6, 3): 'f4'}


def test_reverting_each_edit_is_caught(live, script):
    """わざと壊す: 台本の直しを 1 つずつ元の文に戻すと、その指摘の確かめが落ちる(41 個)。戻さなければ通る"""
    n = 0
    for f, edits in script.ALL:
        for i, (old, new) in enumerate(edits):
            key = (f, i)
            if key not in CATCH:
                assert i == 0 and f in (RB, RD, F6), key          # 頭の記録の行だけ
                continue
            assert live[f].count(new) == 1, key
            broken = dict(live, **{f: live[f].replace(new, old, 1)})
            assert CHECKS[CATCH[key]](broken) != [], key
            n += 1
    assert n == len(CATCH) == 41


def test_more_breakages_are_caught(live, script):
    """わざと壊す(台本の直しと別の形): 手順書に起こし直しと読ませる行を本 X の例外なしで足す・journal を -n に戻す・7 章を fix5 の前の
    形に戻す・答えがまだに 6 を戻す・一式の数を 3.9 GB に戻す"""
    ch7_end = live[RB].index('| いつでも |')
    cases = [
        ('f1', RB, live[RB][:ch7_end] + '| 新しい行 | 出たら OFF に戻った本がある |\n' + live[RB][ch7_end:]),
        ('f1', AP, live[AP].replace(script.AP_OFF_ROW, '')),
        ('f2', TODO, live[TODO].replace(script.CMD_RESTART, 'systemctl is-active jetformer-web; journalctl -u jetformer-web -n 60 '
                                                           '--no-pager | grep -n "Traceback\\|Error" || echo "エラーの行なし"')),
        ('f2', RB, live[RB].replace('journalctl -u jetformer-web -b --no-pager', 'journalctl -u jetformer-web -n 60 --no-pager')),
        ('f2', TODO, live[TODO].replace('systemctl show -p NRestarts --value jetformer-web; journalctl -u jetformer-web --since',
                                        'journalctl -u jetformer-web --since')),
        ('f3', RB, live[RB].replace(script.RB_HOLD_NEW, script.RB_HOLD_OLD)),
        ('f3', AP, live[AP].replace('止まっている間に 2.5G 以上で明けたとき前へ 0.5 m/s より遅い(か後ろへ動いている)車は「中止」',
                                    '止まっている間に 2.5G 以上の車は「中止」')),
        ('f4', TODO, live[TODO].replace('**4・7〜11・13**', '**4・6〜11・13**')),
        ('f4', F6, live[F6].replace('4・7〜11(6 は要らなくなった。10/27 fix7 docs r1)', '4・6〜11')),
        ('f5', RD, live[RD].replace('**約 7.1 GB**', '約 3.9 GB')),
        ('f5', AP, live[AP].replace('10/27 の一式の実測は約 7.1 GB', '10/27 の一式の実測は約 3.9 GB')),
    ]
    for name, f, t in cases:
        assert t != live[f], (name, f)
        assert CHECKS[name](dict(live, **{f: t})) != [], (name, f)


# ================================================================== 文書の言葉と道具・コードの本当の出力
def test_f1_tools_print_what_the_runbook_quotes(live):
    """わざと OFF にした日(1-3 から OFF)に、② runs_1103 は手順書が引く印・区切りを出し、car_check は試験の選択肢の行を出さない
    (OFF の本に行が無いのが正しい = 4 章 10)。本物の関数に作り物の行だけを通す(data/raw は読まない)"""
    R = _load('runs_1103_fix7_docs', JF / 'experiments' / '20261026_fix' / 'plan' / 'runs_1103.py')
    on = {'rec_back_guard': 1, 'rec_hold_keep': 1, 'launch_no_kick': 0}
    off = {'rec_back_guard': 0, 'rec_hold_keep': 0, 'launch_no_kick': 0}
    plan = [('1-1', 2, on), ('1-2', 3, on), ('1-3', 4, off), ('1-4', 5, off), ('1-5', 6, off), ('2-1', 7, off)]
    rs = [{'log': '20261103-1%05d' % i, 'run_id': rid, 'ai_no': str(no), 'options': dict(o), 'diffs': []}
          for i, (rid, no, o) in enumerate(plan)]
    R.round_options(rs)
    assert [bool(r['diffs']) for r in rs] == [False, False, True, True, True, False]       # 回 1 の 3 本だけ
    mark = rs[2]['diffs'][0]
    # 2026-10-28 fix8 tools-decided: 印の後ろの文に「わざと OFF にした日」(3 章)の読み方を足した(頭の「(再起動で OFF に戻った? 」は同じ)
    assert mark.startswith('回 1 の試験の選択肢が 1-1(No.2)と違う: ') and mark.endswith(
        '(再起動で OFF に戻った? 3 章で止めて OFF にした本 X から先なら数える。手順書 3・7 章)')
    line = R.options_line(rs)
    assert line.endswith('1-1(No.2)から 後ろの見張り・リカバリーを残す → 1-3(No.4)から なし(前の本と違う)')
    rb = live[RB]
    ch3 = chapter(rb, '## 3. 朝の準備', '### 3.1')
    quoted = re.search(r'「→ X\(No\.Y\)から なし\(前の本と違う\)」', ch3)
    assert quoted and ('→ 1-3(No.4)から なし(前の本と違う)' == '→ X(No.Y)から なし(前の本と違う)'.replace('X', '1-3').replace('Y', '4'))
    assert '「回 N の試験の選択肢が … と違う(再起動で OFF に戻った? …)」' in ch3
    assert re.sub(r'回 \d', '回 N', mark.split('と違う')[0]).startswith('回 N の試験の選択肢が')
    C = _load('car_check_fix7_docs', JF / 'tools' / 'car_check.py')
    assert C.options_on(off) == [] and C.options_on({}) == []
    names = C.options_on(on)
    tool_line = '試験の選択肢(log.json の走行開始の値): %s が ON' % '・'.join(names)
    assert '「%s」の行がある' % tool_line in one(chapter(rb, '## 4. 1 本の手順', '## 5. '), '| 試験の選択肢(11/3 は全部の本) |')
    QE = _load('qe_by_params_fix7_docs', JF / 'tools' / 'quick_eval_by_params.py')
    assert 'trim' in QE.PARTS                                                # 8.1 ④ の --ignore trim


# ---------------------------------------------------------------- w1-docs-r71-docs-2: 偽物の systemctl・journalctl で文書のコマンドを流す
FAKE_JOURNALCTL = r'''
import json, os, re, sys
from datetime import datetime
E = json.load(open(os.environ['FAKE_JOURNAL'], encoding='utf-8'))
a, since, n, boot, i = sys.argv[1:], None, None, False, 0
while i < len(a):
    x = a[i]
    if x == '-u':
        i += 2
    elif x == '-n':
        n, i = int(a[i + 1]), i + 2
    elif x == '--since':
        since, i = a[i + 1], i + 2
    elif x == '-b':
        boot, i = True, i + 1
    elif x == '--no-pager':
        i += 1
    else:
        sys.exit('fake journalctl: %s' % x)
rows = E
if boot:
    rows = [e for e in rows if e['boot'] == max(r['boot'] for r in E)]
if since is not None:
    m = re.search(r'\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}', since)
    if not m:
        sys.exit('Failed to parse timestamp: %s' % since)
    rows = [e for e in rows if e['t'] >= m.group(0)]
if n is not None:
    rows = rows[-n:]
for e in rows:
    print('%s jetson %s' % (datetime.strptime(e['t'], '%Y-%m-%d %H:%M:%S').strftime('%b %d %H:%M:%S'), e['text']))
'''
FAKE_SYSTEMCTL = r'''
import os, sys
a = sys.argv[1:]
if a[:1] == ['is-active']:
    print(os.environ.get('FAKE_ACTIVE', 'active'))
    sys.exit(0)
if a[:1] == ['show'] and '--value' in a:
    print(os.environ.get('FAKE_' + a[a.index('-p') + 1], ''))
    sys.exit(0)
sys.exit('fake systemctl: %s' % a)
'''

OLD = [{'t': '2026-10-10 09:23:20', 'boot': 0, 'text': 'run_web.sh[12783]: Traceback (most recent call last):'},
       {'t': '2026-10-10 09:23:27', 'boot': 0, 'text': "run_web.sh[12783]: AttributeError: 'AudioSensor' object has no attribute 'channel'"},
       {'t': '2026-10-26 07:41:40', 'boot': 1, 'text': 'systemd[1]: Started jetformer-web.service'},
       {'t': '2026-10-27 17:16:24', 'boot': 1, 'text': 'systemd[1]: Stopping jetformer-web.service'},
       {'t': '2026-10-27 17:16:28', 'boot': 1, 'text': 'systemd[1]: Started jetformer-web.service'}]
START = 'Tue 2026-10-27 17:16:28 JST'


@pytest.fixture()
def fake(tmp_path):
    b = tmp_path / 'bin'
    b.mkdir()
    for name, body in (('journalctl', FAKE_JOURNALCTL), ('systemctl', FAKE_SYSTEMCTL)):
        (b / name).write_text('#!%s\n%s' % (sys.executable, body), encoding='utf-8')
        (b / name).chmod(0o755)
    (b / 'sleep').write_text('#!/bin/sh\nexit 0\n', encoding='utf-8')
    (b / 'sleep').chmod(0o755)

    def run(cmd, journal, nrestarts='0', start=START):
        j = tmp_path / 'journal.json'
        j.write_text(json.dumps(journal, ensure_ascii=False), encoding='utf-8')
        env = {'PATH': '%s:/usr/bin:/bin' % b, 'FAKE_JOURNAL': str(j), 'FAKE_NRestarts': nrestarts,
               'FAKE_ActiveEnterTimestamp': start, 'LANG': 'C.UTF-8'}
        r = subprocess.run(['bash', '-c', cmd], env=env, capture_output=True, text=True, timeout=30)
        assert r.returncode == 0 and r.stderr == '', (cmd, r.stderr)
        return r.stdout.splitlines()
    return run


def test_f2_restart_command_shows_only_this_start(live, before, fake):
    """再起動した日の 3: 今の起動にエラーが無ければ「エラーの行なし」(前の -n 60 の形は 10/10 の古い Traceback を出した)。
    起動のあとの Traceback は出す。落ちて自動で起こし直したら NRestarts が 0 でない(その前の行は --since に入らないので、数で知らせる)"""
    cmd, old_cmd = restart_cmd(live), restart_cmd(before)
    assert '-n 60' in old_cmd and old_cmd != cmd
    assert fake(cmd, OLD) == ['active', '0', 'エラーの行なし']
    assert any('AttributeError' in x for x in fake(old_cmd, OLD))                     # 指摘の形(前のコマンド)
    new_err = OLD + [{'t': '2026-10-27 17:16:31', 'boot': 1, 'text': 'run_web.sh[529689]: Traceback (most recent call last):'},
                     {'t': '2026-10-27 17:16:31', 'boot': 1, 'text': 'run_web.sh[529689]: NameError: x'}]
    out = fake(cmd, new_err)
    assert out[:2] == ['active', '0'] and 'エラーの行なし' not in out and any('NameError' in x for x in out)
    crash = new_err + [{'t': '2026-10-27 17:16:34', 'boot': 1, 'text': 'systemd[1]: Started jetformer-web.service'}]
    out = fake(cmd, crash, nrestarts='1', start='Tue 2026-10-27 17:16:34 JST')
    assert out[:2] == ['active', '1']                                                  # 0 でない → 3' の -b で全部を見る
    todo3b, _ = boot_cmds(live)
    assert any('NameError' in x for x in fake(todo3b, crash, nrestarts='1'))


def test_f2_morning_command_shows_only_this_boot(live, fake):
    """11/3 の朝(Jetson を入れたあと。手順書 3.1 と todo 4 章の 3'): 前の起動の Traceback は出さず、今の起動の Traceback は出す"""
    todo3b, rb31 = boot_cmds(live)
    assert todo3b == rb31
    prev = OLD + [{'t': '2026-11-02 21:00:00', 'boot': 1, 'text': 'run_web.sh[999]: Traceback (most recent call last):'}]
    morning = prev + [{'t': '2026-11-03 07:30:05', 'boot': 2, 'text': 'systemd[1]: Started jetformer-web.service'}]
    assert fake(rb31, morning, start='Tue 2026-11-03 07:30:05 JST') == ['active', '0', 'エラーの行なし']
    bad = morning + [{'t': '2026-11-03 07:30:09', 'boot': 2, 'text': 'run_web.sh[1200]: Traceback (most recent call last):'}]
    out = fake(rb31, bad)
    assert 'エラーの行なし' not in out and any('Nov 03 07:30:09' in x for x in out)


# ---------------------------------------------------------------- w1-docs-r71-docs-3: 本物の assist.Recovery
def _recovery():
    from jetformer import assist as A
    return A


def _wake(A, phase, erpm, g, hold):
    C = N = 1500.0
    model = (C, N - 120.0)
    r = A.Recovery((C, N))
    t = 100.0
    for _ in range(40):                       # 前へ 3 m/s で走っている(armed・段なし)
        r.step(model, -6000.0, t, 0.2, back_guard=True)
        t += 1 / 30.0
    last = t - 1 / 30.0
    if phase:
        r._go(phase, last)
    out, kind = r.step(model, erpm, last + hold, 0.0, back_guard=True, hold_g=g, hold_since=last + 0.05, hold_back_s=0.0)
    return r.phase, out, kind


def test_f3_hold_text_matches_recovery():
    """手順書 7 章「中立で停止中」・approvals 3「ON の形」の文のとおりに本物の Recovery が動く(数も同じ)。前へ = eRPM が負"""
    A = _recovery()
    R = A.Recovery
    assert (R.HOLD_KEEP_MAX_S, R.IMPACT_G, R.HOLD_IMPACT_FWD_ERPM, R.ESCAPE_US, R.HOLD_HALT_MAX_S) == (0.5, 2.5, 1000, 130.0, 0.3)
    assert '1000 eRPM = 0.5 m/s' in A.__doc__                     # 文書の「0.5 m/s」
    GIVE, HALT, ESC = 'giveup', 'halt', 'escape'
    fwd = (-6000.0, -2000.0, -1001.0)                           # 明けたとき前へ 0.5 m/s 以上(3・1・0.5 m/s)
    for phase in (None, 'escape'):
        for e in fwd:
            for g in (0.0, 3.0):                                  # 衝撃があっても・escape の途中でも中止しない
                p, out, _ = _wake(A, phase, e, g, 1.0)
                assert p not in (GIVE, HALT), (phase, e, g, p)
        assert _wake(A, phase, -999.0, 3.0, 1.0)[0] == GIVE       # 衝撃 + 前へ 0.5 m/s より遅い → 中止
        assert _wake(A, phase, 0.0, 0.0, 1.0)[0] == GIVE          # 明けたとき止まっている → 中止
        p, out, _ = _wake(A, phase, 500.0, 3.0, 1.0)               # 衝撃 + 後ろへ動いている → 先に前進(130 µs)で止めてから中止
        assert p == HALT and out == (1500.0, 1500.0 - R.ESCAPE_US)
    for phase in ('brake', 'wait', 'gap', 'reverse', 'coast'):   # リカバリーの後ろ側の途中
        for e in fwd + (-999.0, 0.0):
            assert _wake(A, phase, e, 0.0, 1.0)[0] == GIVE, (phase, e)
            p, out, _ = _wake(A, phase, e, 3.0, 1.0)              # 衝撃 → 中止でなく、すぐ前へ
            assert p == ESC and out == (1500.0, 1500.0 - R.ESCAPE_US), (phase, e)
        assert _wake(A, phase, 500.0, 0.0, 1.0)[0] == HALT       # 後ろへ動いていれば先に前進で止める
    for phase in (None, 'escape', 'brake', 'reverse', 'coast'):  # 0.5 秒までの中立止めは中止しない
        for e in (-6000.0, 0.0):
            assert _wake(A, phase, e, 0.0, 0.4)[0] not in (GIVE, HALT), (phase, e)


# ---------------------------------------------------------------- w1-docs-r71-docs-4: 候補が 0 にならない
def test_f4_candidates_still_there():
    """decisions_v3.json の E3 は決まり(V1・V2)で、e5_open_seal.py plan(読むだけ)の答えは「開ける」。これが崩れたら approvals 6 が
    また要る(文書を戻す)"""
    d = json.loads((REPORTS / 'decisions_v3.json').read_text(encoding='utf-8'))
    e3 = d['E3']
    assert e3.get('final') is True and e3.get('V1') and e3.get('V2')
    r = subprocess.run([sys.executable, '-I', str(JF / 'experiments' / '20261026_fix' / 'fix3' / 'e5_open_seal.py'), 'plan'],
                       capture_output=True, text=True, timeout=120, cwd=str(JF))
    assert r.returncode == 0, r.stderr
    j = json.loads(r.stdout[:r.stdout.index('\n答え')])
    assert j['plan']['open'] is True and j['plan']['n_candidates'] >= 1 and j['candidates']['final'] is True
    assert '答え: 開ける(11/1 朝・1 回だけ)' in r.stdout


# ---------------------------------------------------------------- 既定値(文書が言う「既定 OFF・起動で OFF」)
def test_defaults_the_documents_state():
    """文書が言う既定(試験の選択肢 3 つは既定 0・起動で 0)が drive.py の今の値と同じ。この組はコードを変えていない"""
    from jetformer import drive
    for k in ('rec_back_guard', 'rec_hold_keep', 'launch_no_kick', 'launch_boost'):
        assert drive.DEFAULT_PARAMS[k] == 0 and k in drive.RESET_ON_BOOT, k
    assert drive.PARAM_LIMITS['rec_back_guard'] == (0, 1) and drive.PARAM_LIMITS['rec_hold_keep'] == (0, 1)
