        p.append('approvals 3 ON の形: fix5 の前の文(衝撃だけで中止)が残っている')
    _miss(p, '9 章 rec_hold_keep', chapter(d[RB], '## 9. まだ無いもの', '\n| 安全の理由で'), '走っている車(明けたとき前へ 0.5 m/s 以上)を衝撃だけで中止しない')
