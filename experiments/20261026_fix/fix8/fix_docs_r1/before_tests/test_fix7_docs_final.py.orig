def h1_problems(d):
    p = []
    rb = d[RB]
    ch3 = chapter(rb, '## 3. 朝の準備', '### 3.1')
    now = one(ch3, '  - **最初のリカバリーの「おかしな動き」の今**')
    _miss(p, '3 章 おかしな動きの今', now, '7-2 回目の形(ブレーキの途中にカメラが一瞬止まって中立止めが入った直後)',
          'fix7 安全の 7-2 回目の直しが入ったサーバー(3.1)では起きないはず', '**見張りが OFF でも同じ形になる道が残る**',
          'リカバリーの約 0.3% の見込み', '`fix3/approvals.md` 14', 'すぐ人側 → 止めて OFF → 紙に')
    lines = ch3.splitlines()
    i = next((k for k, x in enumerate(lines) if x.startswith('  - **最初のリカバリーの「おかしな動き」の今**')), None)
    if i is None or i + 1 >= len(lines) or not lines[i + 1].startswith('  - 見張り・残すが ON の日(11/3)は、**その日の最初のリカバリーを人が見る**'):
        p.append('3 章: 「おかしな動き」の今の行が、最初のリカバリーの行のすぐ上に無い')
    j31 = [x for x in chapter(rb, '### 3.1', '## 4. ').splitlines() if '**jetformer-web だけを再起動した日**' in x]
    _miss(p, '3.1 jetformer-web だけ', j31[0] if len(j31) == 1 else '', '`todo_user_1026.md` 4 章の 3(起動の時刻 ActiveEnterTimestamp から)',
          '`-b` は Jetson を入れてからの全部 = 前のサーバーの行も出す')
    _miss(p, '4 章 6', one(chapter(rb, '## 4. 1 本の手順', '## 5. '), '6. 車を HS のいつもの場所に止めて'),
          '■ で止めて新しい本にするときも同じ', '置いていないことは記録から分からない')
    return p


