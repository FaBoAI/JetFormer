def h4_problems(d):
    p = []
    ap = d[AP]
    _miss(p, 'approvals 0 章の 14', one(chapter(ap, '## 0. 一覧', '## 1. '), '| 14 |'), '**このまま**', '返事が無ければこのまま')
    _miss(p, 'approvals 答えがまだ', ap, '**答えがまだなのは 4・7〜11 と、新しい 13**')      # 14 は知らせ(答えがまだに数えない)
    if '4・7〜11・13・14' in ap:
        p.append('approvals: 14 を答えがまだに数えている')
    if '## 14. ' not in ap:
        return p + ['approvals 14 章が無い']
    c14 = ap[ap.index('## 14. '):]
    body = [x for x in c14.splitlines() if x.startswith('| ') and not x.startswith('| こと |')]
    if len(body) != 4:
        p.append('approvals 14: 表の行が 4 でない(%d)' % len(body))
    for w in ('41 組のうち 22 組', '**見張り ON・見張り OFF・fix7 の前のどれも同じ 22 組**', 'リカバリーの約 0.3% の見込み',
              '本物の記録 235 本では起きていない', '**本物の ESC では確かめていない**', '最大 1.83 m/s', '**どれも 11/3 は今のコードのまま**',
              '答え方: 「14 はこのまま」'):
        _miss(p, 'approvals 14', c14, w)
    if not body or sum('**このまま**' in x for x in body) != 3 or '10 のおすすめ (a)' not in body[-1]:
        p.append('approvals 14: おすすめが「このまま」3 つ・10 の (a) 1 つでない')
    ap8 = chapter(ap, '## 8. 回 3 の判定の読み方', '## 9. ')
    _miss(p, 'approvals 8 fix7 で残した読み方', one(ap8, '- (', '**fix7 で残した読み方**'), '① リカバリーの途中', '② 試しの本・途中で変えた本',
          '③ 0.5 秒より短い中立止め', '`--skip 記録名@AI側にした秒`', '今の道具の形のまま =「このまま」に入る')
    _miss(p, 'approvals 2 誰が', one(chapter(ap, '## 2. jetformer-web の再起動の日', '## 3. '), '| 誰が |'),
          '10/27 15:4x の了承(「jetformer-web を再起動してもいいですよ」)が当たるかは main session が決める', '`fix7/README.md` 5 章')
    return p


def h5_problems(t):
    p = []
    for i in IDS_R1 + IDS_R2:
        if t.count('**%s**' % i) != 1:
            p.append('fix7/README: 指摘 %s が 0 章の表にちょうど 1 回無い' % i)
    for h in ('## 0. ひと目で', '## 1. 1 巡目の中身', '## 2. 2 巡目の中身', '## 3. 残すこと', '## 4. 了承が要ること', '## 5. 再起動が要るか',
              '## 6. 試験と、そのあと', '## 7. 次に', '## 8. 文書に入れたもの'):
        if h not in t:
            p.append('fix7/README: 「%s」が無い' % h)
    _miss(p, 'fix7/README', t, '**直した 19 件・直さなかった 0 件**', '**2 巡目にも新しい指摘が 10 件出た = 出切っていない**',
          '**jetformer-web の再起動が要る**', 'approvals.md` 14', '「途中で OFF にした日」')
    if '## 5. 再起動が要るか' in t:
        c5 = chapter(t, '## 5. 再起動が要るか', '## 6. ')
        _miss(p, 'fix7/README 5 章', c5, '`jetformer/assist.py`・`drive.py`・`web/server.py`・`web/bench.py` を変えたら要る', '→ **要る**',
              '**`drive.py`(19:36:17。安全 7-1)・`assist.py`(22:02:15。安全 7-2)**', '**10/27 17:16:28**')
    return p


