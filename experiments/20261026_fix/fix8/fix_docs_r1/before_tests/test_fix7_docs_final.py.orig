        assert h5_problems(t.replace(w, w[:-2] + 'X' + w[-1], 1)) != [], k


def test_script_edits_all_done_and_earlier_intact(live, script, fix8, tmp_path):
    """台本の 19 個の足しは今の文書でどれも「済」で new はちょうど 1 回。文書 7-1・7-2 回目の直し(new がちょうど 1 回)・画面の版 9 と、
    その 2 つの試験の確かめ(f1〜f5・g1〜g6)も崩れていない。
    2026-10-28 fix8 docs-decided: 台本の直しが「済」かは fix8 の書き換え(SUPERSEDE)を戻した文書で、試験の確かめは今の文書で照らす
    (script.earlier_intact は同じ文書で両方を見るので、中身を分けて同じことをする。fix6/README.md も戻した文書で)。書き換えた文は
    今の文書にちょうど 1 回(消した文は 0 回)"""
    full = dict(live, **{'fix6/README.md': (REPORTS / 'fix6' / 'README.md').read_text(encoding='utf-8')})
    assert fix8.superseded_present(full) == []
    old = fix8.revert(full)
    _, rep = script.apply_text(old)
    assert len(rep) == 19 and [s for _, _, s in rep] == ['done'] * 19, [(f, o[:30], s) for f, o, s in rep if s != 'done']
    for f, edits in script.ALL:
        for _, new in edits:
            assert old[f].count(new) == 1, (f, new[:40])
    # script.earlier_intact の中身: 7-2 回目の 45 個が「済」で new がちょうど 1 回・7-1 回目の 44 個と画面の版 9(r1_intact)
    r2 = _load('docs_fix7_r2_from_final_t', script.R2)
    _, rep2 = r2.apply_text(old)
    assert [(f, o[:30], s) for f, o, s in rep2 if s != 'done'] == []
    for f, edits in r2.ALL:
        for _, new in edits:
            assert old[f].count(new) == 1, (f, new[:40])
    assert r2.r1_intact(old) == []
    # 前の組の試験の確かめ(7-1 回目の f1〜f5・7-2 回目の g1〜g6)は今の文書で空
    sys.path.insert(0, str(JF))
    sys.path.insert(0, str(JF / 'tools'))
    sys.path.insert(0, str(JF / 'tests'))
    t1 = _load('t_fix7_docs_r1_from_final_t', script.T1)
    t2 = _load('t_fix7_docs_r2_from_final_t', script.T2)
    for k, fn in sorted(t1.CHECKS.items()):
        assert fn(full) == [], k
    for k, fn in sorted(t2.CHECKS.items()):
        assert fn(full, tmp_path / k) == [], k


# 台本の (文書, 何番目) → それを元に戻すと落ちる確かめ。0 番目(頭の記録の行)は「済」の試験が見る
CATCH = {(RB, 1): 'h1', (RB, 2): 'h1', (RB, 3): 'h1',
         (TODO, 1): 'h2', (TODO, 2): 'h2', (TODO, 3): 'h2', (TODO, 4): 'h2',
         (RD, 1): 'h3', (RD, 2): 'h3', (RD, 3): 'h3', (RD, 4): 'h3',
         (AP, 1): 'h4', (AP, 2): 'h4', (AP, 3): 'h4', (AP, 4): 'h4'}


def test_reverting_each_edit_is_caught(live, script, fix8):
    """2026-10-28 fix8 docs-decided: fix8 が書き換えた足しは、書き換えたあとの形の new(fix8.effective)を元の文に戻す"""
    n = 0
    for f, edits in script.ALL:
        for i, (old, new) in enumerate(edits):
            if (f, i) not in CATCH:
                assert i == 0, (f, i)
                continue
            new = fix8.effective('final', f, i, new)
            assert live[f].count(new) == 1, (f, i)
            broken = dict(live, **{f: live[f].replace(new, old, 1)})
            assert broken[f] != live[f] and CHECKS[CATCH[(f, i)]](broken) != [], (f, i)
            n += 1
    assert n == len(CATCH) == 15


def test_more_breakages_are_caught(live):
    """台本の足しと別の形の壊し: 14 を答えがまだに数える・14 の行を 1 つ消す・おかしな動きの今の行を下に動かす・3.1 の -b を勧める"""
    ap, rb = live[AP], live[RB]
    c14 = ap[ap.index('## 14. '):]
    row = [x for x in c14.splitlines() if x.startswith("| 'gap' を飛ばした後退")][0]
    ch3 = chapter(rb, '## 3. 朝の準備', '### 3.1')
    now = one(ch3, '  - **最初のリカバリーの「おかしな動き」の今**')
    cases = [('h4', AP, ap.replace('**答えがまだなのは 4・7〜11 と、新しい 13**', '**答えがまだなのは 4・7〜11・13・14**')),
             ('h4', AP, ap.replace(row + '\n', '')),
             ('h1', RB, rb.replace(now + '\n', '').replace('\n\n### 3.1 ', '\n' + now + '\n\n### 3.1 ', 1)),
             ('h1', RB, rb.replace('`-b` でなく `todo_user_1026.md` 4 章の 3', '`-b` で', 1)),
             ('h2', TODO, live[TODO].replace('■ で止めて新しい本にするときも、HS に置いてから ▶', '■ で止めて新しい本にする'))]
    for k, (name, f, t) in enumerate(cases):
        assert t != live[f], k
        assert CHECKS[name](dict(live, **{f: t})) != [], k


# ================================================================== 文書の数とコード・報告
def test_numbers_are_in_the_code_and_reports():
    """approvals 14・手順書の数(中立 0.15 秒・0.35 秒・0.2 秒・300・中立止め 0.5 秒)は assist.py の今の定数。割合・組の数は報告の数"""
    sys.path.insert(0, str(JF))
    from jetformer import assist as A
    R = A.Recovery
    assert (R.GAP_S, A.CHECK_S, A.SURE_BACK_S, A.BACKING_ERPM, R.HOLD_KEEP_MAX_S) == (0.15, 0.35, 0.2, 300, 0.5)
    assert issubclass(A.EscMayReverse, A.EscTrack) and A.EscMayReverse.READY_NEUTRAL_S == 0.0
    src = Path(A.__file__).read_text(encoding='utf-8')
    assert "'back_no_esc'" in src and "'early_none'" in src
    s1 = (FIX7 / 'fix_safety_r1.md').read_text(encoding='utf-8')
    s2 = (FIX7 / 'fix_safety_r2.md').read_text(encoding='utf-8')
    t1 = (FIX7 / 'fix_tools_r1.md').read_text(encoding='utf-8')
    t2 = (FIX7 / 'fix_tools_r2.md').read_text(encoding='utf-8')
    for w in ('41 組のうち **22 組。', 'リカバリーの 0.3% ほど', '最初の \'gap\' では下がれないのは 11%', '人の 29 回すべて後退しなかった'):
        assert w in s1, w
    for w in ('本物の記録 235 本では起きていない', '最大 1.83 m/s', 'SURE_BACK_S(0.2 秒)', '後ろ 1.2・1.35 m'):
        assert w in s2, w
    assert '本物で 7 区間' in t1 and '0.33 秒' in t2
    st = (JF / 'tools' / 'standing_3lap.py').read_text(encoding='utf-8')
    assert 'HOLD_KEEP_MAX_S' in st                                       # 「0.5 秒より短い中立止め」は assist.Recovery の値を読む


def test_restart_claim_matches_the_files():
    """fix7/README 5 章の「要る」: assist.py・drive.py は、そこに書いた起動の時刻(10/27 17:16:28)より新しい"""
    t0 = datetime(2026, 10, 27, 17, 16, 28).timestamp()
    for f in ('assist.py', 'drive.py'):
        assert (JF / 'jetformer' / f).stat().st_mtime > t0, f
