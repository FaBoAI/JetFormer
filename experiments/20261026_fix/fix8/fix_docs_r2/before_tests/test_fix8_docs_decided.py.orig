    if 'のまま' in r4:
        p.append('README 3.2 の 4: 「のまま」(PYTEST_GB 3.9)が残っている')
    _miss(p, 'approvals 1 なぜ', one(_sec(d[AP], '## 1. ディスクの片付け', '## 2. '), '| なぜ |'),
          '**10/28 追記**: 10/28 の一式は `-o tmp_path_retention_policy=failed` を付けて約 0.6 GB', '`PYTEST_GB` も 0.6 に')
    dk = d[DK]
    _miss(p, 'disk.md 0 章', one(_sec(dk, '## 0. 要点', '## 1. '), '| pytest 一式の最中 |'), '**10/28 の実測**',
          '`-o tmp_path_retention_policy=failed` を付けて約 0.6 GB', '付けないと約 7.1 GB')
    _miss(p, 'disk.md 2 章', one(_sec(dk, '## 2. 見積もりの元', '## 3. '), '| pytest 一式 |'), '**約 0.6 GB**', '**約 7.1 GB**',
          '`PYTEST_GB` 0.6・`PYTEST_GB_KEEP` 7.1')
    if one(_sec(dk, '## 2. 見積もりの元', '## 3. '), '| pytest 一式 |').startswith('| pytest 一式 | 3.9 GB'):
        p.append('disk.md 2 章: 作業場所が 3.9 GB のまま')
    _miss(p, 'fix6/README 7 章 1', one(_sec(d[F6], '## 7. 次に', '### 今のファイル'), '| 1 |'),
          '`-o tmp_path_retention_policy=failed` を付けて約 0.6 GB')
    return p


def i5_problems(d):
    """「次に」: commit 9da6d0d・反証 8 回目の途中・次の再起動・fix7/README 7 章の済んだ行の印"""
    p = []
    td, rd = d[TODO], d[RD]
    _miss(p, 'todo 2 章 6', one(td, '| 6 | git commit |'), '**9da6d0d**(10/28 00:56。反証 7 回目の直し)', '反証 8 回目')
    _miss(p, 'todo 1 章 再起動', one(td, '| 再起動は**済**'), '**もう一度 ' + RESTART + '**')
    _miss(p, 'README 0 章 7', one(rd, '| 7 | git commit'), '**9da6d0d**(10/28 00:56。反証 7 回目の直し)も push **済**')
    _miss(p, 'README 6 章の頭', _sec(rd, '## 6. 残っていること', '### 6.1'), '**反証 8 回目の途中**', '`fix8/decided_tools.md`',
          '`fix8/decided_safety.md`', '`fix8/decided_docs.md`', '**反証 8 回目のあとにもう一度再起動**')
    c61 = _sec(rd, '### 6.1', '### 6.2')
    _miss(p, 'README 6.1 の 3', one(c61, '| 3 |'), '**3415 passed**', '`fix7/pytest_full_20261028.txt`')
    _miss(p, 'README 6.1 の 5', one(c61, '| 5 |'), '**9da6d0d** を 10/28 00:56 に push')
    c62 = _sec(rd, '### 6.2', '### 6.3')
    _miss(p, 'README 6.2 の 29', one(c62, '| 29 |'), '**反証 8 回目を始めた**')
    _miss(p, 'README 6.2 の 32', one(c62, '| 32 |'), '`fix8/proposal_safety_after1103.md`', 'drive.py の説明の文を入れる', '11/3 の前')
    _miss(p, 'README 6.3 の 31', one(_sec(rd, '### 6.3', '### 6.4'), '| 31 |'), '10/28: `drive.py` の説明の文・`runs_1103` の印の文と本「—」の区切り・'
          '`PYTEST_GB` は fix8 の係が直した')
    _miss(p, 'README 7 章', one(rd[rd.index('## 7. 報告の一覧'):] if '## 7. 報告の一覧' in rd else '', '| `fix8/decided_tools.md`'),
          '`fix8/decided_docs.md`', '反証 8 回目の最初の係(10/28)')
    f7 = _sec(d[F7], '## 7. 次に', '### 今のファイル')
    for n, w in ((1, '**済**(10/28: 反証 8 回目を始めた)'), (2, '**済**(' + RESTART + '。'), (3, '**済**(10/28: 3415 passed・commit 9da6d0d'),
                 (4, '**済**(10/28: approvals 3 は (a)')):
        if not one(f7, '| %d | %s' % (n, w)):
            p.append('fix7/README 7 章 %d: 済の印が無い' % n)
    for n in (5, 6, 7):
        if one(f7, '| %d | **済**' % n):
            p.append('fix7/README 7 章 %d: 済んでいないのに済の印' % n)
    return p


LOG_HEADS = {RB: '- **10/28 03:3x fix8 係 docs-decided**', TODO: '- **10/28 03:3x fix8 係 docs-decided**', RD: '- **10/28 03:3x 追記**(fix8 係 docs-decided。',
             AP: '- **今(10/28 03:3x。fix8 係 docs-decided が今に合わせた。', DK: '- **10/28 03:3x 追記**(fix8 係 docs-decided。',
             F6: '- 10/28 03:3x fix8 係 docs-decided(', F7: '- (10/28 03:3x fix8 係 docs-decided。'}


def i6_problems(d):
    """頭の記録の 1 行(最初の見出し「## 」より前・控えの名前)"""
    p = []
    for f, head in LOG_HEADS.items():
        t = d[f]
        top = t[:t.index('\n## ')] if '\n## ' in t else t
        line = one(top, head)
        _miss(p, '%s の頭の記録' % f, line, '控え `%s.bak-20261028-fix8-decided`' % Path(f).name)
    return p


CHECKS = {'i1': i1_problems, 'i2': i2_problems, 'i3': i3_problems, 'i4': i4_problems, 'i5': i5_problems, 'i6': i6_problems}


# ================================================================== 文書
@pytest.mark.parametrize('name', sorted(CHECKS))
def test_live_documents(live, name):
    assert CHECKS[name](live) == []


@pytest.mark.parametrize('name', sorted(CHECKS))
def test_before_copies_fail(before, name):
    """直す前の写し(10/28 03:0x。fix7 docs の仕上げのあと)では、6 つとも落ちる"""
    assert CHECKS[name](before) != []


def test_before_copies_are_the_backups():
    """直す前の写しは、文書の横の控え(.bak-20261028-fix8-decided)と同じ中身"""
    for f in FILES:
        assert _sha(BEFORE / f) == _sha(REPORTS / (f + '.bak-20261028-fix8-decided')), f


def test_script_edits_all_done(live, script, r81, s1):
    """台本の 68 個の直しは今の文書でどれも「済」で new がちょうど 1 回。SUPERSEDE の書き換えは、前の台本の new の中にちょうど 1 回
    あった文の書き換えで、今の文書に入っている(消した文は 0 回)。前の係の直し・試験の確かめ・この組の確かめも崩れていない。
    2026-10-28 fix8 docs r1: 台本の直しが「済」か・earlier_problems は fix8 docs r1 の書き換え(SUPERSEDE)を戻した文書で照らす。
    この組の SUPERSEDE 21 か所は今の文書でも見る。i1〜i6 は今の文書で test_live_documents が見る。
    2026-10-28 fix8 docs 同期 1: その前に 同期 1 の書き換えを戻す(同期 1 の書き換えも今の文書にちょうど 1 回)"""
    assert r81.superseded_present(live) == [] and s1.superseded_present(live) == []
    base = r81.revert(s1.revert(live))
    assert base != live
    _, rep = script.apply_text(base)
    assert len(rep) == 68 and [s for _, _, s in rep] == ['done'] * 68, [(f, o[:30], s) for f, o, s in rep if s != 'done']
    for f, edits in script.ALL:
        for _, new in edits:
            assert base[f].count(new) == 1, (f, new[:40])
    assert len(script.SUPERSEDE) == 21 and script.superseded_present(base) == [] and script.superseded_present(live) == []
    assert script.earlier_problems(base) == []


def test_reverting_each_edit_is_caught(live, script, r81, s1):
    """わざと壊す: 台本の直しを 1 つずつ元の文に戻すと、i1〜i6 のどれかが落ちる(68 個)。
    2026-10-28 fix8 docs r1: fix8 docs r1 が書き換えた直しは、書き換えたあとの形の new(r81.effective)を元の文に戻す。
    2026-10-28 fix8 docs 同期 1: 同期 1 が書き換えた直しは、その書き換えのあとの形(s1.effective)"""
    n = 0
    for f, edits in script.ALL:
        for k, (old, new) in enumerate(edits):
            new = s1.effective('decided', f, k, r81.effective('decided', f, k, new))
            assert live[f].count(new) == 1, (f, k)
            broken = dict(live, **{f: live[f].replace(new, old, 1)})
            assert broken[f] != live[f], (f, k)
            assert any(fn(broken) for fn in CHECKS.values()), (f, k, new[:40])
            n += 1
    assert n == 68


def test_more_breakages_are_caught(live):
    """台本の直しと別の形の壊し"""
    rb, ap, rd = live[RB], live[AP], live[RD]
    cases = [
        ('i1', AP, ap.replace('**→ 10/28 00:5x main session の判断: 当たる**', '**→ 10/28 00:5x main session の判断**')),
        ('i2', AP, ap.replace('閉じたループ 1,438 組', '閉じたループ 1,348 組')),
        ('i2', RB, rb.replace('はそのまま ⑤ の行で読む(**10/28 main session の決め (a)**', 'の読み方は main session が決める(**', 1)),
        ('i3', AP, ap.replace('→ **今のまま**(10/28 main session の決め)', '→ **変えた**(10/28 main session の決め)')),
        ('i4', RD, rd.replace('`PYTEST_GB` は 0.6', '`PYTEST_GB` は 0.6 のまま')),
    ]
    for name, f, t in cases:
        assert t != live[f], (name, f)
        assert CHECKS[name](dict(live, **{f: t})) != [], (name, f)
    # 済んでいない 7 章 5 に済の印を付ける
    f7 = live[F7].replace('| 5 | approvals', '| 5 | **済**。approvals', 1)
    assert f7 != live[F7] and i5_problems(dict(live, **{F7: f7})) != []


# ================================================================== 文書の数・言葉とコード・記録
def test_restart_record_matches_user_decisions():
    """再起動の時刻・確かめ・決め(a)・①② は main session の記録(user_decisions.md 10/28 00:5x)と同じ"""
    ud = (REPORTS / 'user_decisions.md').read_text(encoding='utf-8')
    for w in ('| 10/28 00:5x | (実行の記録)jetformer-web のもう一度の再起動', '**10/28 00:53:23 に再起動**(boot_at 00:53:24)',
              '3415 passed・2 failed・4 skipped', '試験を 81a4d34 に固定して 15 passed', 'active・NRestarts 0・エラーの行なし',
              '「起動より新しいコードなし」', '「画面の版 9(app.js 10/27 21:58)」', '10/27 15:4x の了承「jetformer-web を再起動してもいいですよ」と同じ目的',
              'main session が **(a)** に決めた', 'main session が **変える** に決めた', '③ は今の形のまま'):
        assert w in ud, w
    full = (REPORTS / 'fix7' / 'pytest_full_20261028.txt').read_text(encoding='utf-8')
    assert '2 failed, 3415 passed, 4 skipped' in full and '空きの一番少ないとき 9913M(00:44)' in full
    assert re.search(r'^55M\texperiments/20261026_fix/tmp_pytest_full_20261028$', full, re.M)
    assert '開始 10/28 00:08' in full and '終了 10/28 00:52' in full


def test_drive_doc_change_is_comment_only_and_after_the_restart():
    """drive.py は 00:53:23 の起動のあとに直した(3.1 の確かめが名前を出す)が、説明の文(docstring)のほかは直す前の写しと AST で同じ
    (= 動きは同じ。fix8 safety-decided の写し tests/fixtures/fix8_safety_doc_before/ の sha256 を照らす)"""
    drive = JF / 'jetformer' / 'drive.py'
    assert drive.stat().st_mtime > datetime(2026, 10, 28, 0, 53, 23).timestamp()
    fx = JF / 'tests' / 'fixtures' / 'fix8_safety_doc_before'
    sums = dict(reversed(x.split(None, 1)) for x in (fx / 'SHA256SUMS').read_text().splitlines() if x.strip())
    assert _sha(fx / 'drive.py') == sums['drive.py']

    def body(src):
        tree = ast.parse(src)
        if tree.body and isinstance(tree.body[0], ast.Expr) and isinstance(getattr(tree.body[0], 'value', None), ast.Constant):
            tree.body = tree.body[1:]
        return ast.dump(tree)
    now, old = drive.read_text(encoding='utf-8'), (fx / 'drive.py').read_text(encoding='utf-8')
    assert body(now) == body(old) and now != old
    # assist.py は fix7(22:02)のまま = 00:53:23 の起動より前
    assert (JF / 'jetformer' / 'assist.py').stat().st_mtime < datetime(2026, 10, 28, 0, 53, 23).timestamp()


def test_safety_numbers_are_in_the_outputs():
    """approvals 3 の決まりの行の数は fix8 safety-decided の出力と assist.py の定数"""
    a = (SAFETY_OUT / 'analyze10.txt').read_text(encoding='utf-8')
    assert '合計 A 1438/1438 同じ  B 2970/2970 同じ  C 0/92 同じ' in a and "'hold_long'" in a
    r = (SAFETY_OUT / 'analyze_rec10.txt').read_text(encoding='utf-8')
    assert '発進 53' in r and all('同じ・' in x for x in r.splitlines()[3:8])
    g = (SAFETY_OUT / 'scan_gaps10.txt').read_text(encoding='utf-8')
    n23 = int(re.search(r"20261023 \{'intervals': (\d+), .*'0\.5': (\d+)\}", g).group(1))
    n24, l24 = map(int, re.search(r"20261024 \{'intervals': (\d+), .*'0\.5': (\d+)\}", g).groups())
    assert (n23 + n24, l24) == (45918, 1)
    sys.path.insert(0, str(JF))
    from jetformer import assist as A
    assert (A.Recovery.ARM_ERPM, A.Recovery.STOP_ERPM, A.Recovery.HOLD_KEEP_MAX_S) == (1000, 300, 0.5)
    assert '1000 eRPM = 0.5 m/s' in A.__doc__


def test_disk_words_match_disk_check():
    """README・approvals・disk.md の PYTEST_GB の数と、disk.md の「pytest 一式の最中」の行の形は disk_check.py と同じ"""
    m = _load('disk_check_fix8_docs', JF / 'experiments' / '20261026_fix' / 'fix3' / 'disk' / 'disk_check.py')
    assert (m.PYTEST_GB, m.PYTEST_GB_KEEP) == (0.6, 7.1)
    rd = (REPORTS / RD).read_text(encoding='utf-8')
    assert '`PYTEST_GB` は %s' % m.PYTEST_GB in rd and '始めに約 %.1f GB' % (8 + m.PYTEST_GB) in rd
    src = (JF / 'experiments' / '20261026_fix' / 'fix3' / 'disk' / 'disk_check.py').read_text(encoding='utf-8')
    fmt = re.search(r"print\('(pytest 一式の最中: [^']*)'\s*\n\s*'([^']*)'", src)
    line = fmt.group(1) + fmt.group(2)
    for k, v in (('%.2f', 'X'), ('%.1f', str(m.PYTEST_GB)), ('%.1f', str(m.PYTEST_GB_KEEP)), ('%.2f', 'Y'), ('%.2f', 'Z')):
        line = line.replace(k, v, 1)
    assert '「%s」' % line in (REPORTS / DK).read_text(encoding='utf-8'), line


def test_tool_words_match_the_code():
    """手順書・approvals・todo が引く fix8 tools-decided の言葉は、本物の道具の文字列から作れる"""
    co = (JF / 'experiments' / '20261026_fix' / 'diag_launch' / 'collect.py').read_text(encoding='utf-8')
    st = (JF / 'tools' / 'standing_3lap.py').read_text(encoding='utf-8')
    qp = (JF / 'tools' / 'quick_eval_by_params.py').read_text(encoding='utf-8')
    rn = (JF / 'experiments' / '20261026_fix' / 'plan' / 'runs_1103.py').read_text(encoding='utf-8')
    rb = (REPORTS / RB).read_text(encoding='utf-8')
    assert "STOP_KIND_TEXT['recovery'] = 'リカバリーの途中'" in st and "RECOVERY_TEXT = 'リカバリーの途中'" in co
    assert "'%s %s 秒から %s 秒' % (STOP_KIND_TEXT['recovery']" in st and "'%s %s 秒から %s 秒' % (RECOVERY_TEXT" in co
    assert "ok += '・数えない(%s。%s・人側 %s 秒)'" in st and "RESUME_NAME = 'リカバリー中止のあとの走り直し'" in st
    assert "RECOVERY_NOTE = ('- 「リカバリーの途中 X 秒から Y 秒」のリカバリー中止のあとの走り直し = " in st
    assert "' 中止のあとの走り直し(%s・人側 %s 秒。%s)'" in co and "'比べに入れない' if r.get('to_r1_s') is not None else 'R1 に届かなかった発進に数える'" in co
    assert "('リカバリー(当たった・止まったあとのブレーキ・後退・前進など)の途中で人が CH3 を人側にした区間のあとも同じ'" in co
    assert "(('midrun', '途中で変えた本'), ('trial', '試しの本'))" in co
    assert "lines.append('  → %sの ON の発進が空転した %d 本(比 > %.1f か、比が出ないのに車輪が増えた = いちばんひどい空転): %s → 空転の'" in co
    assert "lines.append('  → %sの ON の発進で空転の比が出ない %d 本: %s → 空転を確かめられない = 満たさない(checks の '" in co
    assert "(('途中で変えた', mids), ('試し', trials))" in co and "'。' + gap_tag[id(r)]" in co
    assert "'(3 章で止めて OFF にした本 X から先の OFF なら起こし直しではない = 数える。手順書 3・7 章)'" in co
    assert "'リカバリー(当たった・止まったあとのブレーキ・後退・前進など)の途中で人が CH3 を人側にした区間のあとの発進も同じ'" in qp
    assert "'(③ の表の「リカバリーの途中 X 秒から Y 秒」)。'" in qp
    assert "OPT_MARK_NOTE = '(再起動で OFF に戻った? 3 章で止めて OFF にした本 X から先なら数える。手順書 3・7 章)'" in rn
    assert "'回の本は %s(No.%s)から'" in rn
    # 手順書の引用がその文字列どおり
    for q in ('「  → 試しの本の ON の発進が空転した N 本 …」', '「  → 試しの本の ON の発進で空転の比が出ない N 本: …」',
              '「(3 章で止めて OFF にした本 X から先の OFF なら起こし直しではない = 数える。手順書 3・7 章)」',
              '「(再起動で OFF に戻った? 3 章で止めて OFF にした本 X から先なら数える。手順書 3・7 章)」',
              '「 中止のあとの走り直し(リカバリーの途中 X 秒から Y 秒・人側 Z 秒。比べに入れない / R1 に届かなかった発進に数える)」',
              '「数えない(リカバリー中止のあとの走り直し。リカバリーの途中 X 秒から Y 秒・人側 Z 秒)」', '「(… 回の本は X(No.Y)から)」'):
        assert q in rb, q


def test_commit_is_in_git():
    """todo・README の「9da6d0d」は git にある commit(読むだけ)"""
    r = subprocess.run(['git', '-C', str(JF), 'cat-file', '-t', '9da6d0d'], capture_output=True, text=True, timeout=30)
    if r.returncode != 0 and 'not a git repository' in r.stderr:
        pytest.skip('git が無い')
    assert r.stdout.strip() == 'commit'
