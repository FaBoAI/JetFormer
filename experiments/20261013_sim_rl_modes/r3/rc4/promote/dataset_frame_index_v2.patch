+def _frame_indexed(veh, cam_t):
+    """正解(未来の操作)をフレームの番号で引くシーンか。True になるのは、VEHICLE の quality が 'snapshot' で、かつ
+    操作の数がカメラのフレームと同じで、各カメラのフレームの最新の操作がちょうど同じ番号のとき(操作がカメラのフレームと 1 対 1)。
+
+    見分けの本体は「1 対 1」の条件のほう。quality = 'snapshot' は実機の VEHICLE.npz(recorder.py が書く。100 Hz)にも付くので、
+    quality だけでは展開したシミュレーターのシーンと区別できない。実機のシーンは VEHICLE が 100 Hz・カメラが 30 Hz で
+    1 対 1 にならないため、今までどおり時刻で引く(確認 recover r3: data/raw の実機のシーン 138 は前後でビット単位で同じ)。
+    1 対 1 になるのは、scene_import.dataset_to_scenes がデータセットから展開したシーン(VEHICLE の時刻 = カメラの時刻)だけ"""
+    q = veh.get('quality')
+    if q is None or str(np.asarray(q)) != 'snapshot':
+        return False
+    vt = veh['timestamps_us']
+    return len(vt) == len(cam_t) and np.array_equal(_latest_index(vt, cam_t), np.arange(len(cam_t)))
+
