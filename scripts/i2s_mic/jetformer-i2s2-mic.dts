/*
 * JetFormer基板のI2S MEMSマイク: 40ピンヘッダのI2S2を有効にする(Jetson Orin Nano 開発キット p3768)
 *   pin12 = SCLK(soc_gpio41_ph7, Jetsonが出力) / pin35 = FS・LRCLK(soc_gpio44_pi2, 出力) / pin38 = DIN(soc_gpio43_pi1, 入力)
 * NVIDIA純正の tegra234-p3737-...-audio-adafruit-sph0645lm4h.dtbo と同じピン設定を p3768 向けにしたもの。
 * 作り方: dtc -@ -I dts -O dtb -o jetformer-i2s2-mic.dtbo jetformer-i2s2-mic.dts
 */
/dts-v1/;
/plugin/;

/ {
	overlay-name = "JetFormer I2S MEMS mic (40pin I2S2)";
	jetson-header-name = "Jetson 40pin Header";
	compatible = "nvidia,p3768-0000+p3767-0005-super", "nvidia,p3768-0000+p3767-0005",
		     "nvidia,p3768-0000+p3767-0004", "nvidia,p3768-0000+p3767-0003",
		     "nvidia,p3768-0000+p3767-0001", "nvidia,p3768-0000+p3767-0000";

	fragment@0 {
		target = <&pinmux>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&jetformer_i2s_mic>;
			jetformer_i2s_mic: exp-header-pinmux {
				hdr40-pin12 {
					nvidia,pins = "soc_gpio41_ph7";
					nvidia,function = "i2s2";
					nvidia,pull = <1>;
					nvidia,tristate = <0>;
					nvidia,enable-input = <1>;
				};
				hdr40-pin35 {
					nvidia,pins = "soc_gpio44_pi2";
					nvidia,function = "i2s2";
					nvidia,pull = <1>;
					nvidia,tristate = <0>;
					nvidia,enable-input = <1>;
				};
				hdr40-pin38 {
					nvidia,pins = "soc_gpio43_pi1";
					nvidia,function = "i2s2";
					nvidia,pull = <1>;
					nvidia,tristate = <1>;
					nvidia,enable-input = <1>;
				};
			};
		};
	};
};
